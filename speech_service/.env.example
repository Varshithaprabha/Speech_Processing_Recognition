# Copy to .env (git ignores it) and fill in. Everything is free; with nothing set, Ollama + rules are used.

# Free key from https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# Order to try AI providers (rules are always the last fallback)
# LLM_PROVIDERS=groq,ollama
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING=low
# ASR_PROVIDERS=groq,local
# GROQ_ASR_MODEL=whisper-large-v3
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://localhost:11434      # docker-compose sets host.docker.internal automatically

# SIGN_WS_URL=ws://localhost:8001/ws
# WHISPER_MODEL=small

# Optional, paid: add "anthropic" to LLM_PROVIDERS and set
# ANTHROPIC_API_KEY=
